From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Tue, 14 Apr 2026 16:20:00 +0800
Subject: [PATCH] arm64: dts: rockchip: add H88K 240x135 LCD overlay

Port the Hlink H88K SPI LCD overlay from Armbian's linux-rockchip 6.1
tree so rk3588 beta kernels can expose the built-in 240x135 front panel
through the panel-mipi-dbi-spi driver.

---
 arch/arm64/boot/dts/rockchip/overlay/Makefile       |  1 +
 .../dts/rockchip/overlay/hinlink-h88k-240x135-lcd.dts | 59 +++++++++++++++++++
 2 files changed, 60 insertions(+)
 create mode 100644 arch/arm64/boot/dts/rockchip/overlay/hinlink-h88k-240x135-lcd.dts

diff --git a/arch/arm64/boot/dts/rockchip/overlay/Makefile b/arch/arm64/boot/dts/rockchip/overlay/Makefile
index c52c5080a065..e9d2b3f59d3a 100644
--- a/arch/arm64/boot/dts/rockchip/overlay/Makefile
+++ b/arch/arm64/boot/dts/rockchip/overlay/Makefile
@@ -18,6 +18,7 @@ dtbo-$(CONFIG_ARCH_ROCKCHIP) += \
	 hifive-premier-p550-display-jadard-jd9365da-h3.dtb \
	 hifive-premier-p550-pwm-fan.dtb \
	 himinipc-r1-max-power-pciedev0.dtb \
+	 hinlink-h88k-240x135-lcd.dtbo \
	 jackdking-minipc-t1-audio-es8316.dtb \
	 jackdking-minipc-t1-cpufreq-2ghz.dtb \
	 jackdking-minipc-t1-display-lcd101-201.dtb \
diff --git a/arch/arm64/boot/dts/rockchip/overlay/hinlink-h88k-240x135-lcd.dts b/arch/arm64/boot/dts/rockchip/overlay/hinlink-h88k-240x135-lcd.dts
new file mode 100644
index 000000000000..cbbdf583e3a0
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/overlay/hinlink-h88k-240x135-lcd.dts
@@ -0,0 +1,59 @@
+/dts-v1/;
+/plugin/;
+#include <dt-bindings/clock/rk3588-cru.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+
+/ {
+	fragment@0 {
+		target = <&spi4>;
+		__overlay__ {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			assigned-clocks = <&cru CLK_SPI4>;
+			assigned-clock-rates = <200000000>;
+			num-cs = <1>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&spi4_custom_pins &spi4m2_cs0>;
+			status = "okay";
+
+			panel: panel@0 {
+				compatible = "hinlink-h88k-240x135-lcd", "panel-mipi-dbi-spi";
+				reg = <0>;
+
+				spi-max-frequency = <2000000>;
+
+				width-mm = <25>;
+				height-mm = <15>;
+
+				dc-gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
+
+				write-only;
+
+				timing: panel-timing {
+					hactive = <240>;
+					vactive = <135>;
+					hback-porch = <40>;
+					vback-porch = <52>;
+
+					clock-frequency = <0>;
+					hfront-porch = <0>;
+					hsync-len = <0>;
+					vfront-porch = <0>;
+					vsync-len = <0>;
+				};
+			};
+		};
+	};
+	fragment@1 {
+		target = <&pinctrl>;
+		__overlay__ {
+			lcd {
+				spi4_custom_pins: spi4-custom-pins {
+					rockchip,pins =
+					/* spi4_clk_m2 */
+					<1 RK_PA2 8 &pcfg_pull_up_drv_level_6>,
+					/* spi4_mosi_m2 */
+					<1 RK_PA1 8 &pcfg_pull_up_drv_level_6>,
+					/* spi4_miso_m0 */
+					<1 RK_PC0 8 &pcfg_pull_up_drv_level_6>;
+				};
+			};
+		};
+	};
+};
-- 
2.39.5

